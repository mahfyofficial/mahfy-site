RewriteEngine On
RewriteBase /

# Force HTTPS on the live domain
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?mahfy\.in$ [NC]
RewriteRule ^ https://mahfy.in%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.mahfy\.in$ [NC]
RewriteRule ^ https://mahfy.in%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
